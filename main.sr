use rust::std::vec::Vec;
use rust::std::env::args;
use rust::std::env::Args;
use rust::std::path::PathBuf;

@derive(Debug, Default, Clone)
obj ParsedArg:
    buf: string

@derive(Debug, Default)
obj Cli:
    exe: PathBuf
    pargs: Vec<ParsedArg>

fn main():
  var mut args = args()
  var mut cli = Cli::default()
  var opt_arg = args.next()
  if opt_arg.is_none():
    cli.exe = PathBuf::from("")
  else:
    cli.exe = PathBuf::from(opt_arg.unwrap())

  for arg in args:
      var pa = ParsedArg { buf: arg.solar_to_string() }
      cli.pargs.solar_push(&pa)
  
  dbg!(cli)
