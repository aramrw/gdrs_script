obj Vector<T>:
    buffer: *mut T
    len: i32
    cap: i32

impl<T> Vector<T>:
    fn new(capacity: i32) -> *box self:
        *mut raw_buffer = [0; capacity]
        *box v = self {
            buffer: raw_buffer,
            len: 0,
            cap: capacity
        }
        v

    fn push(mut self, item: T):
        if self.len < self.cap:
            self.buffer[self.len] = item
            self.len = self.len + 1
        else:
            print("vector overflow")

    fn get(self, index: i32) -> T:
        self.buffer[index]

fn main():
    // var mut is required because we call push()
    var mut vec = Vector::new(10)
    
    vec.push(42)
    vec.push(100)
    
    print("Item 0:")
    print(vec.get(0))
    print("Item 1:")
    print(vec.get(1))
