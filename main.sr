use crate::std::vec::Vec

obj DataNode:
    id: i32
    values: *mut String

fn run_benchmark():
    var iterations = 1000000
    println!("Allocating {} DataNodes on the heap...", iterations)
    
    var mut i = 0
    while i < iterations:
        var node = *box(DataNode {
            id: i,
            values: ["hello...............".into(); 500]
        })
        
        if i % 250000 == 0:
            println!("  Progress: {}%", (i * 100) / iterations)
            
        i = i + 1

fn main():
    println!("=== Solar Heap Benchmark ===")
    
    // Using a block expression to measure benchmark "readiness"
    var ready = {
        var status = true
        status
    }

    if ready:
        run_benchmark()
    
    println!("Benchmark Complete.")
