use std::vec

fn main():
    var mut vector = vec::Vector::new(0)
    vector.push(10)
    vector.push(20)
    vector.push(30)

    println!("Vector len: {}", vector.len())
    println!("Item at 0: {}", vector.get(0))
    println!("Item at 1: {}", vector.get(1))
    println!("Item at 2: {}", vector.get(2))

		var test_none = vector.get(40)
		println!(test_none)

    return Ok(())
