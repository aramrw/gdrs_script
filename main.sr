rust dependency macroquad = "0.4"
use crate::macroquad::prelude::*;
use crate::macroquad::math::Vec2

obj Circle:
	r: f32
	pos: Vec2

impl Circle:
	fn new(pos: Vec2, r: f32) -> Self:
		Self { pos, r }
		
	fn draw(&self):
		var pos = &self.pos;
		draw_circle(pos.x, pos.y, self.r, RED);
		


#[macroquad::main("window")]
async fn main():
	var circle = Circle::new(vec2(250.0, 200.0), 25.0)
	*const c_ptr = circle as *const Circle

	loop:
		clear_background(BLACK)
		circle.draw()
		next_frame().await
