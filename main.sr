use rust::std::ops::Sub;

#[derive(Clone, Debug)]
obj Vec2:
	x: f32
	y: f32

fn vec2(x: f32, y: f32) -> Vec2:
		Vec2 { x, y }

impl Vec2:
	fn self_pow2(self) -> Self:
		var x2 = self.x *= self.x
		var y2 = self.y *= self.x
		var vec2 = Vec2 { x: x2, y: y2 }
		vec2
		

