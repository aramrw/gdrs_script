obj Point:
    x: i32
    y: i32

obj Sprite:
    pos: *Point

fn main():
    var mut p = Point { x: 1, y: 2 }
    println!("Initial p.x: ", p.x)
    
    // This should trigger promotion of p to *Point
    var s = Sprite { pos: &p }
    
    s.pos.x = 100
    println!("Updated p.x through sprite: ", p.x)
    println!("Sprite pos x: ", s.pos.x)
    
    return Ok(())
