rust dependency "color-eyre" = "0.6"
rust dependency "ratatui" = "0.30"
rust dependency "crossterm" = "0.28"

use crate::color_eyre
use crate::ratatui
use crate::ratatui::{DefaultTerminal, Frame}
use crate::crossterm

fn main() -> color_eyre::Result<()>:
    color_eyre::install()?
    ratatui::run(app)?

fn app(terminal: &mut DefaultTerminal) -> color_eyre::Result<()>:
    loop:
        terminal.draw(render)?
        var e = crossterm::event::read()?
        break
    Ok(())

fn render(frame: &mut Frame):
    frame.render_widget("hello world", frame.area())
