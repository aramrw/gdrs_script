rust dependency macroquad = { version = "0.3" }
rust dependency "macroquad-particles" = { version = "0.1.0", features = ["nanoserde"] }
rust dependency nanoserde = "0.1"

// Added math for rotation logic
use crate::macroquad::prelude::*;
use crate::macroquad::math::Vec2

obj Triangle:
    a: Vec2
    b: Vec2
    c: Vec2
    angle: f32

impl Triangle:
    // Finds the geometric center (centroid) of the triangle
    fn get_centroid(&self) -> Vec2:
        vec2(
            (self.a.x + self.b.x + self.c.x) / 3.0,
            (self.a.y + self.b.y + self.c.y) / 3.0
        )

    // Rotates a point around a pivot
    fn rotate_point(p: Vec2, pivot: Vec2, angle: f32) -> Vec2:
        var s = angle.sin()
        var c = angle.cos()
        
        // Translate point back to origin
        var px = p.x - pivot.x
        var py = p.y - pivot.y

        // Rotate point
        var xnew = px * c - py * s
        var ynew = px * s + py * c

        // Translate point back
        vec2(xnew + pivot.x, ynew + pivot.y)

    fn draw_dynamic(&self):
        var center = self.get_centroid()
        var rot_a = Triangle::rotate_point(self.a, center, self.angle)
        var rot_b = Triangle::rotate_point(self.b, center, self.angle)
        var rot_c = Triangle::rotate_point(self.c, center, self.angle)

        // Draw the filled rotating triangle with a pulsing glow
        var pulse = (get_time() as f32).sin() * 0.2 + 0.8
        var color = Color::new(1.0, 1.0, 1.0, pulse)
        
        draw_triangle(rot_a, rot_b, rot_c, color)
        
        // Draw the wireframe outline
        draw_triangle_lines(rot_a, rot_b, rot_c, 3.0, GOLD)

    fn update(&mut self):
        // Rotate based on time
        self.angle = self.angle + 0.01
        
        // Move point 'a' toward the mouse position smoothly
        var mouse_pos = mouse_position()
        var mouse = vec2(mouse_pos.0, mouse_pos.1)
        self.a.x = self.a.x + (mouse.x - self.a.x) * 0.1
        self.a.y = self.a.y + (mouse.y - self.a.y) * 0.1

async fn gameloop(mut t: Triangle):
    while true:
        clear_background(BLACK)
        
        t.update()
        t.draw_dynamic()

        draw_text("Move your mouse to stretch the triangle!", 20.0, 20.0, 30.0, WHITE)
        next_frame().await

#[macroquad::main("InterativeTriangle")]
async fn main():
    var mut t = Triangle { 
        a: vec2(200.0, 500.0),
        b: vec2(400.0, 200.0),
        c: vec2(600.0, 500.0),
        angle: 0.0
    }
    
    gameloop(t).await
