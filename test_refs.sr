obj Point:
    x: i32
    y: i32

impl Point:
    fn new(x: i32, y: i32) -> Self:
        Self { x, y }

    fn move_by(&mut self, dx: i32, dy: i32):
        self.x = self.x + dx
        self.y = self.y + dy

    fn get_x(&self) -> i32:
        return self.x

fn takes_ref(p: &Point):
    println!("Point x: ", p.x)
    println!("Type of p: ", typeof!(p))

fn takes_mut_ref(p: &mut Point):
    p.move_by(10, 10)
    println!("Type of p in takes_mut_ref: ", typeof!(p))

fn main():
    var mut p = Point::new(1, 2)
    println!("Initial type of p: ", typeof!(p))
    
    takes_ref(&p)
    takes_mut_ref(&mut p)
    
    println!("Final x: ", p.get_x())
    println!("Final type of p: ", typeof!(p))

    return Ok(())
