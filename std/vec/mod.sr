obj Vector<T>:
    raw: *box RawVector<T>

impl<T> Vector<T>:
    fn new(val: T) -> Self:
        return self {
            raw: RawVector<T>::new(20, val.clone())
        }

    fn new_with_value(val: T) -> Self:
        return self {
            raw: RawVector<T>::new(20, val.clone())
        }

    fn push(&mut self, item: T):
        self.raw.push(item)

    fn get(&self, index: i32) -> T:
        return self.raw.get(index)

    fn len(&self) -> i32:
        return self.raw.len()

obj RawVector<T>:
    buffer: *mut T
    length: i32
    cap: i32

impl<T> RawVector<T>:
    fn new(capacity: i32, default_item: T) -> *box self:
        // Note: Ensure mem::alloc is used if you want this on the heap
        var raw_buffer = [default_item; capacity]
        *box v = self {
            buffer: raw_buffer,
            length: 0,
            cap: capacity
        }
        v

    fn grow(&mut self):
        var new_cap = self.cap * 2
        var new_buffer = mem::alloc<T>(new_cap)
        
        var mut i = 0
        while i < self.length:
            unsafe:
                *new_buffer.add(i) = self.buffer[i].clone()
            i = i + 1
        
        mem::free(self.buffer, self.cap)
        self.buffer = new_buffer
        self.cap = new_cap

    fn push(&mut self, item: T):
        if self.length >= self.cap:
            self.grow()

        unsafe:
            *self.buffer.add(self.length) = item.clone()
        
        self.length = self.length + 1

    fn get(&self, index: i32) -> T:
        return self.buffer[index].clone()

    fn len(&self) -> i32:
        return self.length

    fn destroy(&mut self):
        mem::free(self.buffer, self.cap)
