obj Vector<T>:
    buffer: *mut T
    len: i32
    cap: i32

impl<T> Vector<T>:
    fn new(capacity: i32, default_item: T) -> *box self:
        *mut raw_buffer = [default_item; capacity]
        *box v = self {
            buffer: raw_buffer,
            len: 0,
            cap: capacity
        }
        v

    fn push(&mut self, item: T):
        if self.len < self.cap:
            self.buffer[self.len] = item.clone()
            self.len = self.len + 1
        else:
            println!("vector overflow")

    fn get(&self, index: i32) -> T:
        return self.buffer[index].clone()

    fn destroy(&mut self):
        mem::free(self.buffer, self.cap)
